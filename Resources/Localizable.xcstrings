        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae los atajos de Shottr y su configuración de subida a S3 (bucket, endpoint, región, carpeta y enlace). Las claves de S3 no se pueden leer: escríbelas en Subida."
          }
